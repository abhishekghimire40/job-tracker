PORT="8080"

# Postgres (used by compose.yaml; pick your own password in .env)
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="db-name"
POSTGRES_PORT="5432"

# Connection string for goose (and later the app). Must match the values
# above; URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgres://user:password@localhost:5432/db-name?sslmode=disable"
